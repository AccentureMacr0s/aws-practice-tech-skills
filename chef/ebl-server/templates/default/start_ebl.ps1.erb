# EBL Application Startup Script
# Generated by Chef cookbook: ebl-server

param(
    [Parameter(Mandatory=$false)]
    [switch]$Force,
    
    [Parameter(Mandatory=$false)]
    [switch]$Verbose
)

$ServiceName = "<%= @service_name %>"
$AppName = "<%= @app_name %>"
$InstallDir = "<%= @install_dir %>"
$PackageName = "<%= @package_name %>"
$DataDir = "<%= @data_dir %>"
$LogDir = "<%= @log_dir %>"

function Write-EBLLog {
    param([string]$Message, [string]$Level = "INFO")
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [START] [$Level] $Message"
    Write-Output $logMessage
    Add-Content -Path "$LogDir\ebl_startup.log" -Value $logMessage
}

function Test-Prerequisites {
    Write-EBLLog "Checking EBL application prerequisites..." "INFO"
    
    # Check if EBL executable exists
    $eblPath = "$InstallDir\$PackageName"
    if (-not (Test-Path $eblPath)) {
        Write-EBLLog "EBL executable not found at $eblPath" "ERROR"
        return $false
    }
    
    # Check if configuration exists
    $configPath = "$InstallDir\config.xml"
    if (-not (Test-Path $configPath)) {
        Write-EBLLog "EBL configuration not found at $configPath" "WARNING"
    }
    
    # Check if data directory exists
    if (-not (Test-Path $DataDir)) {
        Write-EBLLog "Creating EBL data directory: $DataDir" "INFO"
        New-Item -ItemType Directory -Path $DataDir -Force
    }
    
    # Check if log directory exists
    if (-not (Test-Path $LogDir)) {
        Write-EBLLog "Creating EBL log directory: $LogDir" "INFO"
        New-Item -ItemType Directory -Path $LogDir -Force
    }
    
    Write-EBLLog "Prerequisites check completed successfully" "INFO"
    return $true
}

function Start-EBLService {
    Write-EBLLog "Starting EBL application service..." "INFO"
    
    try {
        # Check if service exists
        $service = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
        if (-not $service) {
            Write-EBLLog "Service '$ServiceName' not found" "ERROR"
            return $false
        }
        
        # Check current service status
        if ($service.Status -eq "Running") {
            if ($Force) {
                Write-EBLLog "Service is running. Force restart requested." "INFO"
                Stop-Service -Name $ServiceName -Force
                Start-Sleep -Seconds 3
            } else {
                Write-EBLLog "Service is already running" "INFO"
                return $true
            }
        }
        
        # Start the service
        Start-Service -Name $ServiceName
        Start-Sleep -Seconds 5
        
        # Verify service started
        $service = Get-Service -Name $ServiceName
        if ($service.Status -eq "Running") {
            Write-EBLLog "EBL service started successfully" "INFO"
            
            # Wait for application to be ready
            Write-EBLLog "Waiting for EBL application to initialize..." "INFO"
            $maxWait = 30
            $waited = 0
            
            while ($waited -lt $maxWait) {
                Start-Sleep -Seconds 2
                $waited += 2
                
                # Test if application is responsive
                try {
                    $testConnection = Test-NetConnection -ComputerName "127.0.0.1" -Port 80 -WarningAction SilentlyContinue
                    if ($testConnection.TcpTestSucceeded) {
                        Write-EBLLog "EBL application is responsive" "INFO"
                        return $true
                    }
                } catch {
                    # Continue waiting
                }
                
                if ($Verbose) {
                    Write-EBLLog "Still waiting for application to respond... ($waited/$maxWait seconds)" "INFO"
                }
            }
            
            Write-EBLLog "Application started but may not be fully ready yet" "WARNING"
            return $true
        } else {
            Write-EBLLog "Failed to start EBL service. Status: $($service.Status)" "ERROR"
            return $false
        }
    } catch {
        Write-EBLLog "Error starting EBL service: $($_.Exception.Message)" "ERROR"
        return $false
    }
}

function Test-EBLHealth {
    Write-EBLLog "Performing post-startup health check..." "INFO"
    
    try {
        # Check service status
        $service = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
        if (-not $service -or $service.Status -ne "Running") {
            Write-EBLLog "Health check failed: Service not running" "ERROR"
            return $false
        }
        
        # Check process
        $process = Get-Process | Where-Object { $_.ProcessName -like "*EBL*" } | Select-Object -First 1
        if ($process) {
            $memoryUsage = [math]::Round($process.WorkingSet64 / 1MB, 2)
            Write-EBLLog "EBL process found: PID $($process.Id), Memory: $memoryUsage MB" "INFO"
        } else {
            Write-EBLLog "Health check warning: EBL process not found" "WARNING"
        }
        
        # Check log files for errors
        $errorLogPath = "$LogDir\*error*.log"
        $recentErrors = Get-ChildItem $errorLogPath -ErrorAction SilentlyContinue | 
                       Where-Object { $_.LastWriteTime -gt (Get-Date).AddMinutes(-5) }
        
        if ($recentErrors) {
            Write-EBLLog "Recent error logs detected - please review" "WARNING"
        } else {
            Write-EBLLog "No recent errors detected" "INFO"
        }
        
        Write-EBLLog "Health check completed" "INFO"
        return $true
    } catch {
        Write-EBLLog "Health check failed: $($_.Exception.Message)" "ERROR"
        return $false
    }
}

# Main execution
Write-EBLLog "EBL Application Startup Script initiated" "INFO"
Write-EBLLog "Application: $AppName" "INFO"
Write-EBLLog "Service: $ServiceName" "INFO"
Write-EBLLog "Install Directory: $InstallDir" "INFO"

$success = $true

# Run prerequisite checks
if (-not (Test-Prerequisites)) {
    Write-EBLLog "Prerequisites check failed" "ERROR"
    $success = $false
}

# Start EBL service
if ($success -and -not (Start-EBLService)) {
    Write-EBLLog "Failed to start EBL service" "ERROR"
    $success = $false
}

# Perform health check
if ($success -and -not (Test-EBLHealth)) {
    Write-EBLLog "Health check failed" "WARNING"
    # Don't fail startup for health check warnings
}

if ($success) {
    Write-EBLLog "EBL application startup completed successfully" "INFO"
    exit 0
} else {
    Write-EBLLog "EBL application startup failed" "ERROR"
    exit 1
}