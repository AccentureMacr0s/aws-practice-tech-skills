# Windows Firewall Management Script for EBL Server
# Generated by Chef cookbook: ebl-server

param(
    [Parameter(Mandatory=$false)]
    [ValidateSet("Enable", "Disable", "Status", "AddRules", "RemoveRules", "TestPorts")]
    [string]$Action = "Status",
    
    [Parameter(Mandatory=$false)]
    [switch]$Force
)

$AppName = "<%= @app_name %>"
$InstallDir = "<%= @install_dir %>"
$PackageName = "<%= @package_name %>"
$Ports = @(
<% @ports.each do |port| -%>
    @{
        Name = "<%= port['name'] %>"
        Port = <%= port['port'] %>
        Protocol = "<%= port['protocol'] %>"
    },
<% end -%>
)

function Write-FirewallLog {
    param([string]$Message, [string]$Level = "INFO")
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [FIREWALL] [$Level] $Message"
    Write-Output $logMessage
}

function Enable-WindowsFirewall {
    Write-FirewallLog "Enabling Windows Firewall for all profiles..." "INFO"
    
    try {
        Set-NetFirewallProfile -Profile Domain,Public,Private -Enabled True
        Write-FirewallLog "Windows Firewall enabled successfully" "INFO"
        return $true
    } catch {
        Write-FirewallLog "Failed to enable Windows Firewall: $($_.Exception.Message)" "ERROR"
        return $false
    }
}

function Disable-WindowsFirewall {
    Write-FirewallLog "Disabling Windows Firewall for all profiles..." "WARNING"
    
    if (-not $Force) {
        Write-FirewallLog "Use -Force parameter to disable firewall" "WARNING"
        return $false
    }
    
    try {
        Set-NetFirewallProfile -Profile Domain,Public,Private -Enabled False
        Write-FirewallLog "Windows Firewall disabled" "WARNING"
        return $true
    } catch {
        Write-FirewallLog "Failed to disable Windows Firewall: $($_.Exception.Message)" "ERROR"
        return $false
    }
}

function Get-FirewallStatus {
    Write-FirewallLog "Checking Windows Firewall status..." "INFO"
    
    try {
        $profiles = Get-NetFirewallProfile
        
        Write-Output "Windows Firewall Status:"
        foreach ($profile in $profiles) {
            $status = if ($profile.Enabled) { "Enabled" } else { "Disabled" }
            Write-Output "  $($profile.Name): $status"
        }
        
        # Check EBL-specific rules
        Write-Output ""
        Write-Output "EBL Application Firewall Rules:"
        $eblRules = Get-NetFirewallRule | Where-Object { $_.DisplayName -like "*EBL*" }
        
        if ($eblRules) {
            foreach ($rule in $eblRules) {
                $status = if ($rule.Enabled) { "Enabled" } else { "Disabled" }
                Write-Output "  $($rule.DisplayName): $($rule.Direction) $($rule.Action) ($status)"
            }
        } else {
            Write-Output "  No EBL-specific rules found"
        }
        
        return $true
    } catch {
        Write-FirewallLog "Failed to get firewall status: $($_.Exception.Message)" "ERROR"
        return $false
    }
}

function Add-EBLFirewallRules {
    Write-FirewallLog "Adding firewall rules for EBL application..." "INFO"
    
    $success = $true
    
    # Add port-based rules
    foreach ($portConfig in $Ports) {
        try {
            $ruleName = $portConfig.Name
            $port = $portConfig.Port
            $protocol = $portConfig.Protocol
            
            Write-FirewallLog "Creating rule: $ruleName (Port $port/$protocol)" "INFO"
            
            # Remove existing rule if it exists
            Remove-NetFirewallRule -DisplayName $ruleName -ErrorAction SilentlyContinue
            
            # Create new inbound rule
            New-NetFirewallRule -DisplayName $ruleName `
                                -Direction Inbound `
                                -Protocol $protocol `
                                -LocalPort $port `
                                -Action Allow `
                                -Profile Domain,Private,Public `
                                -Description "EBL Application - $ruleName"
            
            Write-FirewallLog "Rule '$ruleName' created successfully" "INFO"
        } catch {
            Write-FirewallLog "Failed to create rule '$($portConfig.Name)': $($_.Exception.Message)" "ERROR"
            $success = $false
        }
    }
    
    # Add program-based rule
    try {
        $programPath = "$InstallDir\$PackageName"
        $ruleName = "EBL-Application-Outbound"
        
        if (Test-Path $programPath) {
            Write-FirewallLog "Creating program rule for $programPath" "INFO"
            
            # Remove existing rule if it exists
            Remove-NetFirewallRule -DisplayName $ruleName -ErrorAction SilentlyContinue
            
            # Create outbound rule for EBL application
            New-NetFirewallRule -DisplayName $ruleName `
                                -Direction Outbound `
                                -Program $programPath `
                                -Action Allow `
                                -Profile Domain,Private,Public `
                                -Description "Allow EBL Application outbound connections"
            
            Write-FirewallLog "Program rule created successfully" "INFO"
        } else {
            Write-FirewallLog "EBL application not found at $programPath" "WARNING"
        }
    } catch {
        Write-FirewallLog "Failed to create program rule: $($_.Exception.Message)" "ERROR"
        $success = $false
    }
    
    return $success
}

function Remove-EBLFirewallRules {
    Write-FirewallLog "Removing EBL firewall rules..." "INFO"
    
    $success = $true
    
    try {
        # Remove all EBL-related rules
        $eblRules = Get-NetFirewallRule | Where-Object { $_.DisplayName -like "*EBL*" }
        
        foreach ($rule in $eblRules) {
            try {
                Remove-NetFirewallRule -DisplayName $rule.DisplayName -Confirm:$false
                Write-FirewallLog "Removed rule: $($rule.DisplayName)" "INFO"
            } catch {
                Write-FirewallLog "Failed to remove rule '$($rule.DisplayName)': $($_.Exception.Message)" "ERROR"
                $success = $false
            }
        }
        
        if (-not $eblRules) {
            Write-FirewallLog "No EBL firewall rules found to remove" "INFO"
        }
    } catch {
        Write-FirewallLog "Failed to enumerate EBL rules: $($_.Exception.Message)" "ERROR"
        $success = $false
    }
    
    return $success
}

function Test-EBLPorts {
    Write-FirewallLog "Testing EBL application ports..." "INFO"
    
    foreach ($portConfig in $Ports) {
        $port = $portConfig.Port
        $protocol = $portConfig.Protocol
        $ruleName = $portConfig.Name
        
        try {
            # Check if port is listening
            $listening = $false
            if ($protocol -eq "TCP") {
                $connections = Get-NetTCPConnection -LocalPort $port -ErrorAction SilentlyContinue
                $listening = ($connections.Count -gt 0)
            } elseif ($protocol -eq "UDP") {
                $endpoints = Get-NetUDPEndpoint -LocalPort $port -ErrorAction SilentlyContinue
                $listening = ($endpoints.Count -gt 0)
            }
            
            # Check firewall rule
            $rule = Get-NetFirewallRule -DisplayName $ruleName -ErrorAction SilentlyContinue
            $ruleExists = ($rule -ne $null)
            $ruleEnabled = if ($rule) { $rule.Enabled } else { $false }
            
            Write-Output "Port $port/$protocol ($ruleName):"
            Write-Output "  Listening: $listening"
            Write-Output "  Firewall Rule Exists: $ruleExists"
            Write-Output "  Firewall Rule Enabled: $ruleEnabled"
            
            if ($listening -and $ruleExists -and $ruleEnabled) {
                Write-FirewallLog "Port $port/$protocol is properly configured" "INFO"
            } else {
                Write-FirewallLog "Port $port/$protocol has configuration issues" "WARNING"
            }
        } catch {
            Write-FirewallLog "Failed to test port $port/$protocol: $($_.Exception.Message)" "ERROR"
        }
    }
}

function Export-FirewallConfig {
    $exportPath = "$InstallDir\firewall_backup.wfw"
    
    Write-FirewallLog "Exporting firewall configuration to $exportPath..." "INFO"
    
    try {
        netsh advfirewall export $exportPath
        Write-FirewallLog "Firewall configuration exported successfully" "INFO"
        return $true
    } catch {
        Write-FirewallLog "Failed to export firewall configuration: $($_.Exception.Message)" "ERROR"
        return $false
    }
}

function Import-FirewallConfig {
    $importPath = "$InstallDir\firewall_backup.wfw"
    
    if (-not (Test-Path $importPath)) {
        Write-FirewallLog "Firewall backup file not found: $importPath" "ERROR"
        return $false
    }
    
    Write-FirewallLog "Importing firewall configuration from $importPath..." "INFO"
    
    try {
        netsh advfirewall import $importPath
        Write-FirewallLog "Firewall configuration imported successfully" "INFO"
        return $true
    } catch {
        Write-FirewallLog "Failed to import firewall configuration: $($_.Exception.Message)" "ERROR"
        return $false
    }
}

# Main execution
Write-FirewallLog "Starting firewall management script with action: $Action" "INFO"

switch ($Action) {
    "Enable" { 
        if (Enable-WindowsFirewall) {
            Write-FirewallLog "Firewall enable operation completed successfully" "INFO"
        } else {
            Write-FirewallLog "Firewall enable operation failed" "ERROR"
        }
    }
    "Disable" { 
        if (Disable-WindowsFirewall) {
            Write-FirewallLog "Firewall disable operation completed" "WARNING"
        } else {
            Write-FirewallLog "Firewall disable operation failed" "ERROR"
        }
    }
    "Status" { 
        Get-FirewallStatus
    }
    "AddRules" { 
        if (Add-EBLFirewallRules) {
            Write-FirewallLog "Firewall rules added successfully" "INFO"
        } else {
            Write-FirewallLog "Firewall rules addition completed with errors" "WARNING"
        }
    }
    "RemoveRules" { 
        if (Remove-EBLFirewallRules) {
            Write-FirewallLog "Firewall rules removed successfully" "INFO"
        } else {
            Write-FirewallLog "Firewall rules removal completed with errors" "WARNING"
        }
    }
    "TestPorts" { 
        Test-EBLPorts
    }
    default { 
        Write-FirewallLog "Unknown action: $Action" "ERROR"
        Write-Output "Valid actions: Enable, Disable, Status, AddRules, RemoveRules, TestPorts"
    }
}

Write-FirewallLog "Firewall management script completed" "INFO"