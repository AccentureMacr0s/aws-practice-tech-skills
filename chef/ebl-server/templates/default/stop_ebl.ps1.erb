# EBL Application Shutdown Script
# Generated by Chef cookbook: ebl-server

param(
    [Parameter(Mandatory=$false)]
    [switch]$Force,
    
    [Parameter(Mandatory=$false)]
    [switch]$Wait,
    
    [Parameter(Mandatory=$false)]
    [int]$Timeout = 30
)

$ServiceName = "<%= @service_name %>"
$AppName = "<%= @app_name %>"
$InstallDir = "<%= @install_dir %>"

function Write-EBLLog {
    param([string]$Message, [string]$Level = "INFO")
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [STOP] [$Level] $Message"
    Write-Output $logMessage
    Add-Content -Path "$InstallDir\logs\ebl_shutdown.log" -Value $logMessage
}

function Stop-EBLService {
    Write-EBLLog "Stopping EBL application service..." "INFO"
    
    try {
        # Check if service exists
        $service = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
        if (-not $service) {
            Write-EBLLog "Service '$ServiceName' not found" "WARNING"
            return $true
        }
        
        # Check current service status
        if ($service.Status -eq "Stopped") {
            Write-EBLLog "Service is already stopped" "INFO"
            return $true
        }
        
        Write-EBLLog "Current service status: $($service.Status)" "INFO"
        
        # Attempt graceful shutdown first
        if (-not $Force) {
            Write-EBLLog "Attempting graceful shutdown..." "INFO"
            Stop-Service -Name $ServiceName -ErrorAction SilentlyContinue
            
            # Wait for graceful shutdown
            $maxWait = $Timeout
            $waited = 0
            
            while ($waited -lt $maxWait) {
                Start-Sleep -Seconds 2
                $waited += 2
                
                $service = Get-Service -Name $ServiceName
                if ($service.Status -eq "Stopped") {
                    Write-EBLLog "Service stopped gracefully in $waited seconds" "INFO"
                    return $true
                }
                
                Write-EBLLog "Waiting for graceful shutdown... ($waited/$maxWait seconds)" "INFO"
            }
            
            Write-EBLLog "Graceful shutdown timeout reached" "WARNING"
        }
        
        # Force stop if graceful shutdown failed or Force was requested
        Write-EBLLog "Performing forced shutdown..." "INFO"
        Stop-Service -Name $ServiceName -Force
        Start-Sleep -Seconds 3
        
        # Verify service stopped
        $service = Get-Service -Name $ServiceName
        if ($service.Status -eq "Stopped") {
            Write-EBLLog "EBL service stopped successfully" "INFO"
            return $true
        } else {
            Write-EBLLog "Failed to stop EBL service. Status: $($service.Status)" "ERROR"
            return $false
        }
    } catch {
        Write-EBLLog "Error stopping EBL service: $($_.Exception.Message)" "ERROR"
        return $false
    }
}

function Stop-EBLProcesses {
    Write-EBLLog "Checking for remaining EBL processes..." "INFO"
    
    try {
        # Find EBL processes
        $eblProcesses = Get-Process | Where-Object { $_.ProcessName -like "*EBL*" }
        
        if ($eblProcesses) {
            Write-EBLLog "Found $($eblProcesses.Count) EBL process(es)" "INFO"
            
            foreach ($process in $eblProcesses) {
                Write-EBLLog "Terminating EBL process: PID $($process.Id)" "INFO"
                
                if ($Force) {
                    $process.Kill()
                } else {
                    $process.CloseMainWindow()
                    Start-Sleep -Seconds 5
                    
                    if (-not $process.HasExited) {
                        Write-EBLLog "Process did not exit gracefully, forcing termination" "WARNING"
                        $process.Kill()
                    }
                }
            }
            
            # Wait for processes to exit
            Start-Sleep -Seconds 3
            
            # Verify processes are gone
            $remainingProcesses = Get-Process | Where-Object { $_.ProcessName -like "*EBL*" }
            if ($remainingProcesses) {
                Write-EBLLog "Warning: $($remainingProcesses.Count) EBL process(es) still running" "WARNING"
                return $false
            } else {
                Write-EBLLog "All EBL processes terminated successfully" "INFO"
                return $true
            }
        } else {
            Write-EBLLog "No EBL processes found" "INFO"
            return $true
        }
    } catch {
        Write-EBLLog "Error terminating EBL processes: $($_.Exception.Message)" "ERROR"
        return $false
    }
}

function Clear-EBLTempFiles {
    Write-EBLLog "Cleaning up temporary files..." "INFO"
    
    try {
        # Clean temp files in install directory
        $tempPath = "$InstallDir\temp"
        if (Test-Path $tempPath) {
            Get-ChildItem $tempPath -File | Remove-Item -Force -ErrorAction SilentlyContinue
            Write-EBLLog "Cleaned temporary files from $tempPath" "INFO"
        }
        
        # Clean system temp files related to EBL
        $systemTempPath = $env:TEMP
        Get-ChildItem $systemTempPath -Filter "*EBL*" -ErrorAction SilentlyContinue | Remove-Item -Force -Recurse -ErrorAction SilentlyContinue
        
        Write-EBLLog "Temporary file cleanup completed" "INFO"
        return $true
    } catch {
        Write-EBLLog "Error during temp file cleanup: $($_.Exception.Message)" "WARNING"
        return $false
    }
}

function Save-EBLState {
    Write-EBLLog "Saving application state before shutdown..." "INFO"
    
    try {
        $stateFile = "$InstallDir\data\shutdown_state.json"
        $stateInfo = @{
            ShutdownTime = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
            ShutdownReason = if ($Force) { "Forced" } else { "Graceful" }
            LastKnownStatus = "Stopped"
        }
        
        $stateInfo | ConvertTo-Json | Out-File -FilePath $stateFile -Encoding UTF8
        Write-EBLLog "Application state saved to $stateFile" "INFO"
        return $true
    } catch {
        Write-EBLLog "Failed to save application state: $($_.Exception.Message)" "WARNING"
        return $false
    }
}

# Main execution
Write-EBLLog "EBL Application Shutdown Script initiated" "INFO"
Write-EBLLog "Application: $AppName" "INFO"
Write-EBLLog "Service: $ServiceName" "INFO"
Write-EBLLog "Force: $Force" "INFO"
Write-EBLLog "Timeout: $Timeout seconds" "INFO"

$success = $true

# Save application state
Save-EBLState

# Stop EBL service
if (-not (Stop-EBLService)) {
    Write-EBLLog "Failed to stop EBL service" "ERROR"
    $success = $false
}

# Stop any remaining EBL processes
if (-not (Stop-EBLProcesses)) {
    Write-EBLLog "Failed to stop all EBL processes" "WARNING"
    # Don't fail shutdown for this
}

# Clean up temporary files
Clear-EBLTempFiles

if ($success) {
    Write-EBLLog "EBL application shutdown completed successfully" "INFO"
    exit 0
} else {
    Write-EBLLog "EBL application shutdown completed with errors" "ERROR"
    exit 1
}