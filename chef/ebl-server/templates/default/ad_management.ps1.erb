# Active Directory Management Script for EBL Server
# Generated by Chef cookbook: ebl-server

param(
    [Parameter(Mandatory=$false)]
    [ValidateSet("JoinDomain", "LeaveDomain", "TestConnection", "ManageGroups", "Status")]
    [string]$Action = "Status",
    
    [Parameter(Mandatory=$false)]
    [string]$Domain = "<%= @domain %>",
    
    [Parameter(Mandatory=$false)]
    [string]$Username,
    
    [Parameter(Mandatory=$false)]
    [SecureString]$Password
)

$AdminGroups = @(<%= @admin_groups.map { |g| "'#{g}'" }.join(', ') %>)
$ServiceName = "<%= @service_name %>"

function Write-ADLog {
    param([string]$Message, [string]$Level = "INFO")
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [AD] [$Level] $Message"
    Write-Output $logMessage
}

function Test-DomainConnection {
    Write-ADLog "Testing domain connection to $Domain..." "INFO"
    
    try {
        # Test domain controller connectivity
        $dcTest = Test-ComputerSecureChannel -Verbose
        if ($dcTest) {
            Write-ADLog "Domain trust relationship is working" "INFO"
            return $true
        } else {
            Write-ADLog "Domain trust relationship test failed" "WARNING"
            return $false
        }
    } catch {
        Write-ADLog "Domain connection test failed: $($_.Exception.Message)" "ERROR"
        return $false
    }
}

function Join-Domain {
    param([string]$DomainName, [string]$User, [SecureString]$Pass)
    
    Write-ADLog "Attempting to join domain: $DomainName" "INFO"
    
    if (-not $User -or -not $Pass) {
        Write-ADLog "Username and password are required for domain join" "ERROR"
        return $false
    }
    
    try {
        $credential = New-Object System.Management.Automation.PSCredential($User, $Pass)
        Add-Computer -DomainName $DomainName -Credential $credential -Force -Restart
        Write-ADLog "Domain join initiated. Computer will restart." "INFO"
        return $true
    } catch {
        Write-ADLog "Domain join failed: $($_.Exception.Message)" "ERROR"
        return $false
    }
}

function Leave-Domain {
    Write-ADLog "Attempting to leave current domain..." "INFO"
    
    try {
        Remove-Computer -Force -Restart
        Write-ADLog "Domain leave initiated. Computer will restart." "INFO"
        return $true
    } catch {
        Write-ADLog "Domain leave failed: $($_.Exception.Message)" "ERROR"
        return $false
    }
}

function Manage-AdminGroups {
    Write-ADLog "Managing local administrator groups..." "INFO"
    
    $success = $true
    
    foreach ($group in $AdminGroups) {
        try {
            Write-ADLog "Processing group: $group" "INFO"
            
            # Check if group exists in AD
            $domainGroup = "$Domain\$group"
            
            # Add to local administrators
            $adminGroup = [ADSI]"WinNT://./Administrators,group"
            $members = @($adminGroup.psbase.Invoke("Members")) | ForEach-Object { 
                $_.GetType().InvokeMember("Name", 'GetProperty', $null, $_, $null) 
            }
            
            if ($members -contains $group) {
                Write-ADLog "Group '$group' is already a member of local administrators" "INFO"
            } else {
                $adminGroup.psbase.Invoke("Add", ([ADSI]"WinNT://$Domain/$group,group").Path)
                Write-ADLog "Added '$domainGroup' to local administrators" "INFO"
            }
        } catch {
            Write-ADLog "Failed to add group '$group': $($_.Exception.Message)" "ERROR"
            $success = $false
            
            # Try alternative method
            try {
                $result = net localgroup administrators "$Domain\$group" /add 2>&1
                if ($LASTEXITCODE -eq 0) {
                    Write-ADLog "Successfully added '$Domain\$group' using net localgroup" "INFO"
                } else {
                    Write-ADLog "net localgroup failed: $result" "WARNING"
                }
            } catch {
                Write-ADLog "Alternative method also failed: $($_.Exception.Message)" "ERROR"
            }
        }
    }
    
    return $success
}

function Get-DomainStatus {
    Write-ADLog "Checking domain status..." "INFO"
    
    try {
        $computerSystem = Get-WmiObject -Class Win32_ComputerSystem
        $currentDomain = $computerSystem.Domain
        $partOfDomain = $computerSystem.PartOfDomain
        
        Write-Output "Computer Name: $($computerSystem.Name)"
        Write-Output "Current Domain: $currentDomain"
        Write-Output "Part of Domain: $partOfDomain"
        
        if ($partOfDomain) {
            Write-ADLog "Computer is joined to domain: $currentDomain" "INFO"
            
            # Test domain connectivity
            $connectionOK = Test-DomainConnection
            Write-Output "Domain Connection: $connectionOK"
            
            # List domain groups in local administrators
            Write-Output ""
            Write-Output "Domain groups in local administrators:"
            try {
                $adminGroup = [ADSI]"WinNT://./Administrators,group"
                $members = @($adminGroup.psbase.Invoke("Members")) | ForEach-Object {
                    $path = $_.GetType().InvokeMember("AdsPath", 'GetProperty', $null, $_, $null)
                    if ($path -like "*/$Domain/*") {
                        $name = $_.GetType().InvokeMember("Name", 'GetProperty', $null, $_, $null)
                        Write-Output "  - $name"
                    }
                }
            } catch {
                Write-ADLog "Failed to enumerate local administrators: $($_.Exception.Message)" "WARNING"
            }
        } else {
            Write-ADLog "Computer is not joined to a domain" "INFO"
        }
    } catch {
        Write-ADLog "Failed to get domain status: $($_.Exception.Message)" "ERROR"
    }
}

function Set-ServiceAccountDomain {
    Write-ADLog "Configuring service to use domain account..." "INFO"
    
    try {
        $service = Get-WmiObject -Class Win32_Service -Filter "Name='$ServiceName'"
        if ($service) {
            $currentAccount = $service.StartName
            Write-Output "Current service account: $currentAccount"
            
            if ($currentAccount -notlike "*\*") {
                Write-ADLog "Service is using local account. Consider changing to domain account." "WARNING"
            } else {
                Write-ADLog "Service is already using domain account: $currentAccount" "INFO"
            }
        } else {
            Write-ADLog "Service '$ServiceName' not found" "ERROR"
        }
    } catch {
        Write-ADLog "Failed to check service account: $($_.Exception.Message)" "ERROR"
    }
}

# Main execution
Write-ADLog "Starting AD management script with action: $Action" "INFO"

switch ($Action) {
    "JoinDomain" { 
        if (Join-Domain -DomainName $Domain -User $Username -Pass $Password) {
            Write-ADLog "Domain join successful" "INFO"
        } else {
            Write-ADLog "Domain join failed" "ERROR"
        }
    }
    "LeaveDomain" { 
        if (Leave-Domain) {
            Write-ADLog "Domain leave successful" "INFO"
        } else {
            Write-ADLog "Domain leave failed" "ERROR"
        }
    }
    "TestConnection" { 
        $result = Test-DomainConnection
        Write-Output "Domain connection test: $result"
    }
    "ManageGroups" { 
        if (Manage-AdminGroups) {
            Write-ADLog "Group management completed successfully" "INFO"
        } else {
            Write-ADLog "Group management completed with errors" "WARNING"
        }
    }
    "Status" { 
        Get-DomainStatus
        Set-ServiceAccountDomain
    }
    default { 
        Write-ADLog "Unknown action: $Action" "ERROR"
        Write-Output "Valid actions: JoinDomain, LeaveDomain, TestConnection, ManageGroups, Status"
    }
}

Write-ADLog "AD management script completed" "INFO"