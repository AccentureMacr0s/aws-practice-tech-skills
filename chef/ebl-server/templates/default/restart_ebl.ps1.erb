# EBL Application Restart Script
# Generated by Chef cookbook: ebl-server

param(
    [Parameter(Mandatory=$false)]
    [switch]$Force,
    
    [Parameter(Mandatory=$false)]
    [switch]$CheckDependencies,
    
    [Parameter(Mandatory=$false)]
    [int]$Timeout = 60
)

$ServiceName = "<%= @service_name %>"
$AppName = "<%= @app_name %>"
$InstallDir = "<%= @install_dir %>"
$DataDir = "<%= @data_dir %>"

function Write-EBLLog {
    param([string]$Message, [string]$Level = "INFO")
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [RESTART] [$Level] $Message"
    Write-Output $logMessage
    Add-Content -Path "$InstallDir\logs\ebl_restart.log" -Value $logMessage
}

function Test-EBLDependencies {
    Write-EBLLog "Checking EBL application dependencies..." "INFO"
    
    $dependenciesOK = $true
    
    try {
        # Check database connectivity (example)
        Write-EBLLog "Testing database connectivity..." "INFO"
        # This would contain actual database connection test
        # For now, we'll simulate it
        Start-Sleep -Seconds 2
        Write-EBLLog "Database connectivity: OK" "INFO"
        
        # Check network connectivity
        Write-EBLLog "Testing network connectivity..." "INFO"
        $networkTest = Test-NetConnection -ComputerName "8.8.8.8" -Port 53 -WarningAction SilentlyContinue
        if ($networkTest.TcpTestSucceeded) {
            Write-EBLLog "Network connectivity: OK" "INFO"
        } else {
            Write-EBLLog "Network connectivity: FAILED" "ERROR"
            $dependenciesOK = $false
        }
        
        # Check required services
        Write-EBLLog "Checking required Windows services..." "INFO"
        $requiredServices = @("Eventlog", "RpcSs", "Winmgmt")
        
        foreach ($svcName in $requiredServices) {
            $svc = Get-Service -Name $svcName -ErrorAction SilentlyContinue
            if ($svc -and $svc.Status -eq "Running") {
                Write-EBLLog "Required service '$svcName': Running" "INFO"
            } else {
                Write-EBLLog "Required service '$svcName': NOT RUNNING" "ERROR"
                $dependenciesOK = $false
            }
        }
        
        # Check disk space
        Write-EBLLog "Checking disk space..." "INFO"
        $drive = (Get-Item $InstallDir).PSDrive
        $freeSpaceGB = [math]::Round($drive.Free / 1GB, 2)
        
        if ($freeSpaceGB -gt 1) {
            Write-EBLLog "Disk space: $freeSpaceGB GB available" "INFO"
        } else {
            Write-EBLLog "Disk space: LOW - Only $freeSpaceGB GB available" "WARNING"
        }
        
        # Check memory
        Write-EBLLog "Checking available memory..." "INFO"
        $memory = Get-WmiObject -Class Win32_OperatingSystem
        $freeMemoryGB = [math]::Round($memory.FreePhysicalMemory / 1MB, 2)
        
        if ($freeMemoryGB -gt 0.5) {
            Write-EBLLog "Available memory: $freeMemoryGB GB" "INFO"
        } else {
            Write-EBLLog "Available memory: LOW - Only $freeMemoryGB GB available" "WARNING"
        }
        
    } catch {
        Write-EBLLog "Error checking dependencies: $($_.Exception.Message)" "ERROR"
        $dependenciesOK = $false
    }
    
    return $dependenciesOK
}

function Restart-EBLService {
    Write-EBLLog "Restarting EBL application service..." "INFO"
    
    try {
        # Check if service exists
        $service = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
        if (-not $service) {
            Write-EBLLog "Service '$ServiceName' not found" "ERROR"
            return $false
        }
        
        Write-EBLLog "Current service status: $($service.Status)" "INFO"
        
        # Stop the service
        if ($service.Status -eq "Running") {
            Write-EBLLog "Stopping EBL service..." "INFO"
            
            if ($Force) {
                Stop-Service -Name $ServiceName -Force
            } else {
                Stop-Service -Name $ServiceName
            }
            
            # Wait for service to stop
            $stopTimeout = [math]::Min($Timeout / 2, 30)
            $waited = 0
            
            do {
                Start-Sleep -Seconds 2
                $waited += 2
                $service = Get-Service -Name $ServiceName
                Write-EBLLog "Waiting for service to stop... ($waited/$stopTimeout seconds)" "INFO"
            } while ($service.Status -ne "Stopped" -and $waited -lt $stopTimeout)
            
            if ($service.Status -ne "Stopped") {
                Write-EBLLog "Service did not stop within timeout, forcing stop..." "WARNING"
                Stop-Service -Name $ServiceName -Force
                Start-Sleep -Seconds 3
            }
        }
        
        # Verify service is stopped
        $service = Get-Service -Name $ServiceName
        if ($service.Status -ne "Stopped") {
            Write-EBLLog "Failed to stop service. Current status: $($service.Status)" "ERROR"
            return $false
        }
        
        Write-EBLLog "Service stopped successfully" "INFO"
        
        # Wait a moment before starting
        Start-Sleep -Seconds 3
        
        # Start the service
        Write-EBLLog "Starting EBL service..." "INFO"
        Start-Service -Name $ServiceName
        
        # Wait for service to start
        $startTimeout = $Timeout - ($stopTimeout + 3)
        $waited = 0
        
        do {
            Start-Sleep -Seconds 2
            $waited += 2
            $service = Get-Service -Name $ServiceName
            Write-EBLLog "Waiting for service to start... ($waited/$startTimeout seconds)" "INFO"
        } while ($service.Status -ne "Running" -and $waited -lt $startTimeout)
        
        if ($service.Status -eq "Running") {
            Write-EBLLog "EBL service restarted successfully" "INFO"
            
            # Wait for application to be ready
            Write-EBLLog "Waiting for application to initialize..." "INFO"
            $initWait = 15
            $waited = 0
            
            while ($waited -lt $initWait) {
                Start-Sleep -Seconds 2
                $waited += 2
                
                # Test if application is responsive
                try {
                    $testConnection = Test-NetConnection -ComputerName "127.0.0.1" -Port 80 -WarningAction SilentlyContinue
                    if ($testConnection.TcpTestSucceeded) {
                        Write-EBLLog "EBL application is responsive after restart" "INFO"
                        return $true
                    }
                } catch {
                    # Continue waiting
                }
            }
            
            Write-EBLLog "Service started but application may still be initializing" "WARNING"
            return $true
        } else {
            Write-EBLLog "Failed to start service. Status: $($service.Status)" "ERROR"
            return $false
        }
    } catch {
        Write-EBLLog "Error restarting EBL service: $($_.Exception.Message)" "ERROR"
        return $false
    }
}

function Create-RestartReport {
    Write-EBLLog "Creating restart report..." "INFO"
    
    try {
        $reportPath = "$DataDir\restart_report_$(Get-Date -Format 'yyyyMMdd_HHmmss').json"
        
        $report = @{
            RestartTime = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
            RestartType = if ($Force) { "Forced" } else { "Graceful" }
            DependenciesChecked = $CheckDependencies
            ServiceStatus = (Get-Service -Name $ServiceName -ErrorAction SilentlyContinue).Status
            SystemInfo = @{
                MachineName = $env:COMPUTERNAME
                OSVersion = (Get-WmiObject -Class Win32_OperatingSystem).Caption
                LastBootTime = (Get-WmiObject -Class Win32_OperatingSystem).ConvertToDateTime((Get-WmiObject -Class Win32_OperatingSystem).LastBootUpTime).ToString("yyyy-MM-dd HH:mm:ss")
            }
        }
        
        $report | ConvertTo-Json -Depth 3 | Out-File -FilePath $reportPath -Encoding UTF8
        Write-EBLLog "Restart report saved to $reportPath" "INFO"
        
    } catch {
        Write-EBLLog "Failed to create restart report: $($_.Exception.Message)" "WARNING"
    }
}

# Main execution
Write-EBLLog "EBL Application Restart Script initiated" "INFO"
Write-EBLLog "Application: $AppName" "INFO"
Write-EBLLog "Service: $ServiceName" "INFO"
Write-EBLLog "Force: $Force" "INFO"
Write-EBLLog "Check Dependencies: $CheckDependencies" "INFO"
Write-EBLLog "Timeout: $Timeout seconds" "INFO"

$success = $true

# Check dependencies if requested
if ($CheckDependencies) {
    if (-not (Test-EBLDependencies)) {
        Write-EBLLog "Dependency check failed" "ERROR"
        if (-not $Force) {
            Write-EBLLog "Aborting restart due to dependency failures (use -Force to override)" "ERROR"
            exit 1
        } else {
            Write-EBLLog "Continuing with restart despite dependency failures (Force mode)" "WARNING"
        }
    }
}

# Restart EBL service
if (-not (Restart-EBLService)) {
    Write-EBLLog "Failed to restart EBL service" "ERROR"
    $success = $false
}

# Create restart report
Create-RestartReport

if ($success) {
    Write-EBLLog "EBL application restart completed successfully" "INFO"
    exit 0
} else {
    Write-EBLLog "EBL application restart failed" "ERROR"
    exit 1
}