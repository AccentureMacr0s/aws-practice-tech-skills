# EBL Server Health Check Script
# Generated by Chef cookbook: ebl-server

param(
    [Parameter(Mandatory=$false)]
    [switch]$Detailed,
    
    [Parameter(Mandatory=$false)]
    [switch]$WriteToEventLog
)

$ServiceName = "<%= @service_name %>"
$AppName = "<%= @app_name %>"

# Health check results
$HealthResults = @{
    Service = $null
    CPU = $null
    Memory = $null
    Disk = $null
    Network = $null
    Overall = "Unknown"
}

function Write-HealthLog {
    param([string]$Message, [string]$Level = "INFO")
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [HEALTH] [$Level] $Message"
    Write-Output $logMessage
    
    if ($WriteToEventLog) {
        try {
            $eventType = switch ($Level) {
                "ERROR" { "Error" }
                "WARNING" { "Warning" }
                default { "Information" }
            }
            Write-EventLog -LogName Application -Source $AppName -EventId 1001 -EntryType $eventType -Message $Message
        } catch {
            # Ignore event log errors
        }
    }
}

function Test-ServiceHealth {
    Write-HealthLog "Checking service health..." "INFO"
    
    try {
        $service = Get-Service -Name $ServiceName -ErrorAction Stop
        $HealthResults.Service = @{
            Status = $service.Status
            StartType = $service.StartType
            Healthy = ($service.Status -eq "Running")
        }
        
        if ($service.Status -eq "Running") {
            Write-HealthLog "Service is running" "INFO"
        } else {
            Write-HealthLog "Service is not running: $($service.Status)" "WARNING"
        }
    } catch {
        Write-HealthLog "Service check failed: $($_.Exception.Message)" "ERROR"
        $HealthResults.Service = @{
            Status = "NotFound"
            Healthy = $false
            Error = $_.Exception.Message
        }
    }
}

function Test-CPUHealth {
    Write-HealthLog "Checking CPU usage..." "INFO"
    
    try {
        $cpu = Get-WmiObject -Class Win32_Processor | Measure-Object -Property LoadPercentage -Average
        $cpuUsage = [math]::Round($cpu.Average, 2)
        
        $HealthResults.CPU = @{
            Usage = $cpuUsage
            Healthy = ($cpuUsage -lt 80)
        }
        
        if ($cpuUsage -lt 80) {
            Write-HealthLog "CPU usage is normal: $cpuUsage%" "INFO"
        } else {
            Write-HealthLog "High CPU usage detected: $cpuUsage%" "WARNING"
        }
    } catch {
        Write-HealthLog "CPU check failed: $($_.Exception.Message)" "ERROR"
        $HealthResults.CPU = @{
            Healthy = $false
            Error = $_.Exception.Message
        }
    }
}

function Test-MemoryHealth {
    Write-HealthLog "Checking memory usage..." "INFO"
    
    try {
        $memory = Get-WmiObject -Class Win32_OperatingSystem
        $totalMemory = [math]::Round($memory.TotalVisibleMemorySize / 1MB, 2)
        $freeMemory = [math]::Round($memory.FreePhysicalMemory / 1MB, 2)
        $usedMemory = $totalMemory - $freeMemory
        $memoryPercent = [math]::Round(($usedMemory / $totalMemory) * 100, 2)
        
        $HealthResults.Memory = @{
            TotalGB = $totalMemory
            UsedGB = $usedMemory
            FreeGB = $freeMemory
            UsagePercent = $memoryPercent
            Healthy = ($memoryPercent -lt 85)
        }
        
        if ($memoryPercent -lt 85) {
            Write-HealthLog "Memory usage is normal: $memoryPercent%" "INFO"
        } else {
            Write-HealthLog "High memory usage detected: $memoryPercent%" "WARNING"
        }
    } catch {
        Write-HealthLog "Memory check failed: $($_.Exception.Message)" "ERROR"
        $HealthResults.Memory = @{
            Healthy = $false
            Error = $_.Exception.Message
        }
    }
}

function Test-DiskHealth {
    Write-HealthLog "Checking disk space..." "INFO"
    
    try {
        $disks = Get-WmiObject -Class Win32_LogicalDisk | Where-Object { $_.DriveType -eq 3 }
        $diskResults = @()
        $allDisksHealthy = $true
        
        foreach ($disk in $disks) {
            $totalGB = [math]::Round($disk.Size / 1GB, 2)
            $freeGB = [math]::Round($disk.FreeSpace / 1GB, 2)
            $usedGB = $totalGB - $freeGB
            $usagePercent = [math]::Round(($usedGB / $totalGB) * 100, 2)
            $isHealthy = ($usagePercent -lt 90)
            
            $diskResult = @{
                Drive = $disk.DeviceID
                TotalGB = $totalGB
                UsedGB = $usedGB
                FreeGB = $freeGB
                UsagePercent = $usagePercent
                Healthy = $isHealthy
            }
            
            $diskResults += $diskResult
            
            if (-not $isHealthy) {
                $allDisksHealthy = $false
                Write-HealthLog "High disk usage on $($disk.DeviceID): $usagePercent%" "WARNING"
            }
        }
        
        $HealthResults.Disk = @{
            Disks = $diskResults
            Healthy = $allDisksHealthy
        }
        
        if ($allDisksHealthy) {
            Write-HealthLog "Disk space is adequate on all drives" "INFO"
        }
    } catch {
        Write-HealthLog "Disk check failed: $($_.Exception.Message)" "ERROR"
        $HealthResults.Disk = @{
            Healthy = $false
            Error = $_.Exception.Message
        }
    }
}

function Test-NetworkHealth {
    Write-HealthLog "Checking network connectivity..." "INFO"
    
    try {
        # Test basic connectivity
        $pingResult = Test-Connection -ComputerName "127.0.0.1" -Count 1 -Quiet
        
        # Test DNS resolution
        $dnsResult = $false
        try {
            $null = Resolve-DnsName "google.com" -ErrorAction Stop
            $dnsResult = $true
        } catch {
            # DNS resolution failed
        }
        
        $HealthResults.Network = @{
            LocalConnectivity = $pingResult
            DNSResolution = $dnsResult
            Healthy = ($pingResult -and $dnsResult)
        }
        
        if ($pingResult -and $dnsResult) {
            Write-HealthLog "Network connectivity is healthy" "INFO"
        } else {
            Write-HealthLog "Network connectivity issues detected" "WARNING"
        }
    } catch {
        Write-HealthLog "Network check failed: $($_.Exception.Message)" "ERROR"
        $HealthResults.Network = @{
            Healthy = $false
            Error = $_.Exception.Message
        }
    }
}

function Get-OverallHealth {
    $healthyComponents = 0
    $totalComponents = 0
    
    foreach ($component in $HealthResults.Keys) {
        if ($component -ne "Overall" -and $HealthResults[$component] -ne $null) {
            $totalComponents++
            if ($HealthResults[$component].Healthy) {
                $healthyComponents++
            }
        }
    }
    
    if ($totalComponents -eq 0) {
        $HealthResults.Overall = "Unknown"
    } elseif ($healthyComponents -eq $totalComponents) {
        $HealthResults.Overall = "Healthy"
    } elseif ($healthyComponents -gt ($totalComponents / 2)) {
        $HealthResults.Overall = "Warning"
    } else {
        $HealthResults.Overall = "Critical"
    }
    
    Write-HealthLog "Overall system health: $($HealthResults.Overall)" "INFO"
}

# Main execution
Write-HealthLog "Starting EBL health check..." "INFO"

Test-ServiceHealth
Test-CPUHealth
Test-MemoryHealth
Test-DiskHealth
Test-NetworkHealth
Get-OverallHealth

Write-HealthLog "Health check completed" "INFO"

# Output results
if ($Detailed) {
    Write-Output "=== EBL Server Health Check Results ==="
    Write-Output "Overall Status: $($HealthResults.Overall)"
    Write-Output ""
    
    Write-Output "Service Health:"
    Write-Output "  Status: $($HealthResults.Service.Status)"
    Write-Output "  Healthy: $($HealthResults.Service.Healthy)"
    Write-Output ""
    
    Write-Output "System Resources:"
    Write-Output "  CPU Usage: $($HealthResults.CPU.Usage)% (Healthy: $($HealthResults.CPU.Healthy))"
    Write-Output "  Memory Usage: $($HealthResults.Memory.UsagePercent)% (Healthy: $($HealthResults.Memory.Healthy))"
    Write-Output "  Disk Health: $($HealthResults.Disk.Healthy)"
    Write-Output "  Network Health: $($HealthResults.Network.Healthy)"
} else {
    Write-Output "EBL Server Health: $($HealthResults.Overall)"
}

# Exit with appropriate code
switch ($HealthResults.Overall) {
    "Healthy" { exit 0 }
    "Warning" { exit 1 }
    "Critical" { exit 2 }
    default { exit 3 }
}