# EBL Server Maintenance Script
# Generated by Chef cookbook: ebl-server

param(
    [Parameter(Mandatory=$false)]
    [ValidateSet("Start", "Stop", "Restart", "Status", "Backup", "Cleanup", "Update")]
    [string]$Action = "Status",
    
    [Parameter(Mandatory=$false)]
    [switch]$Force
)

$ServiceName = "<%= @service_name %>"
$InstallDir = "<%= @install_dir %>"
$DataDir = "<%= @data_dir %>"
$LogDir = "<%= @log_dir %>"

function Write-Log {
    param([string]$Message, [string]$Level = "INFO")
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [$Level] $Message"
    Write-Output $logMessage
    Add-Content -Path "$LogDir\maintenance.log" -Value $logMessage
}

function Get-ServiceStatus {
    try {
        $service = Get-Service -Name $ServiceName -ErrorAction Stop
        Write-Log "Service '$ServiceName' is $($service.Status)" "INFO"
        return $service.Status
    } catch {
        Write-Log "Service '$ServiceName' not found or error occurred: $($_.Exception.Message)" "ERROR"
        return $null
    }
}

function Start-EBLService {
    Write-Log "Starting EBL service..." "INFO"
    try {
        Start-Service -Name $ServiceName
        Start-Sleep -Seconds 5
        $status = Get-ServiceStatus
        if ($status -eq "Running") {
            Write-Log "Service started successfully" "INFO"
        } else {
            Write-Log "Service failed to start properly. Status: $status" "WARNING"
        }
    } catch {
        Write-Log "Failed to start service: $($_.Exception.Message)" "ERROR"
    }
}

function Stop-EBLService {
    Write-Log "Stopping EBL service..." "INFO"
    try {
        if ($Force) {
            Stop-Service -Name $ServiceName -Force
        } else {
            Stop-Service -Name $ServiceName
        }
        Start-Sleep -Seconds 5
        $status = Get-ServiceStatus
        if ($status -eq "Stopped") {
            Write-Log "Service stopped successfully" "INFO"
        } else {
            Write-Log "Service failed to stop properly. Status: $status" "WARNING"
        }
    } catch {
        Write-Log "Failed to stop service: $($_.Exception.Message)" "ERROR"
    }
}

function Restart-EBLService {
    Write-Log "Restarting EBL service..." "INFO"
    Stop-EBLService
    Start-Sleep -Seconds 3
    Start-EBLService
}

function Backup-EBLData {
    $backupDir = "$DataDir\backups"
    $timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
    $backupPath = "$backupDir\backup_$timestamp"
    
    Write-Log "Creating backup at $backupPath..." "INFO"
    
    try {
        if (-not (Test-Path $backupDir)) {
            New-Item -ItemType Directory -Path $backupDir -Force
        }
        
        # Create backup directory
        New-Item -ItemType Directory -Path $backupPath -Force
        
        # Copy configuration files
        Copy-Item "$DataDir\*.json" $backupPath -ErrorAction SilentlyContinue
        Copy-Item "$DataDir\*.config" $backupPath -ErrorAction SilentlyContinue
        Copy-Item "$InstallDir\*.xml" $backupPath -ErrorAction SilentlyContinue
        
        # Compress backup
        $zipPath = "$backupPath.zip"
        Compress-Archive -Path $backupPath -DestinationPath $zipPath -Force
        Remove-Item $backupPath -Recurse -Force
        
        Write-Log "Backup completed successfully: $zipPath" "INFO"
        
        # Cleanup old backups (keep last 10)
        Get-ChildItem $backupDir -Filter "backup_*.zip" | Sort-Object CreationTime -Descending | Select-Object -Skip 10 | Remove-Item -Force
        
    } catch {
        Write-Log "Backup failed: $($_.Exception.Message)" "ERROR"
    }
}

function Invoke-Cleanup {
    Write-Log "Performing cleanup operations..." "INFO"
    
    try {
        # Clean temporary files
        Get-ChildItem "$env:TEMP" -Filter "*ebl*" -ErrorAction SilentlyContinue | Remove-Item -Force -Recurse
        
        # Clean old log files (older than 30 days)
        $cutoffDate = (Get-Date).AddDays(-30)
        Get-ChildItem $LogDir -Filter "*.log" | Where-Object { $_.CreationTime -lt $cutoffDate } | Remove-Item -Force
        
        # Clean old backup files (older than 90 days)
        $backupCutoff = (Get-Date).AddDays(-90)
        $backupDir = "$DataDir\backups"
        if (Test-Path $backupDir) {
            Get-ChildItem $backupDir -Filter "*.zip" | Where-Object { $_.CreationTime -lt $backupCutoff } | Remove-Item -Force
        }
        
        Write-Log "Cleanup completed successfully" "INFO"
    } catch {
        Write-Log "Cleanup failed: $($_.Exception.Message)" "ERROR"
    }
}

function Invoke-Update {
    Write-Log "Checking for updates..." "INFO"
    
    # This is a placeholder for update logic
    # In a real scenario, this would check for new versions and update the application
    
    Write-Log "Update check completed (no updates available)" "INFO"
}

# Main execution
Write-Log "EBL Maintenance Script started with action: $Action" "INFO"

switch ($Action) {
    "Start" { Start-EBLService }
    "Stop" { Stop-EBLService }
    "Restart" { Restart-EBLService }
    "Status" { Get-ServiceStatus }
    "Backup" { Backup-EBLData }
    "Cleanup" { Invoke-Cleanup }
    "Update" { Invoke-Update }
    default { 
        Write-Log "Unknown action: $Action" "ERROR"
        Write-Output "Valid actions: Start, Stop, Restart, Status, Backup, Cleanup, Update"
    }
}

Write-Log "EBL Maintenance Script completed" "INFO"